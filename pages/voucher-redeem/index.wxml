<view class="page">
  <Navbar
    title="{{pageTitle}}"
    titleColor="#211a14"
    backgroundColor="#fff8ef"
    borderBottom="{{false}}"
    bottomShadow="{{false}}"
  ></Navbar>

  <view class="content">
    <view class="hero-card">
      <view class="hero-copy">
        <view class="hero-kicker">{{heroKicker}}</view>
        <view class="hero-title">{{heroTitle}}</view>
        <view class="hero-desc">{{heroDesc}}</view>
      </view>
      <view class="hero-badge">
        <view class="hero-badge__scan"></view>
      </view>
    </view>

    <view class="panel">
      <view class="panel-title" wx:if="{{!isExchangeMode}}">选择平台</view>
      <view class="platform-row" wx:if="{{!isExchangeMode}}">
        <view
          wx:for="{{platforms}}"
          wx:key="key"
          class="platform-pill {{selectedPlatform == item.key ? 'active' : ''}}"
          data-platform="{{item.key}}"
          bindtap="selectPlatform"
        >
          {{item.label}}
        </view>
      </view>

      <view class="field-group">
        <view class="field-label">门店</view>
        <picker
          mode="selector"
          range="{{storeNames}}"
          value="{{storeIndex}}"
          bindchange="handleStoreChange"
        >
          <view class="store-picker">
            <view class="store-picker__value">
              {{storesLoading ? '加载门店中...' : (selectedStoreName || '请选择门店')}}
            </view>
            <view class="store-picker__arrow"></view>
          </view>
        </picker>
      </view>

      <view class="field-group">
        <view class="field-label">{{codeLabel}}</view>
        <input
          class="field-input"
          value="{{voucherCode}}"
          placeholder="{{codePlaceholder}}"
          confirm-type="done"
          bindinput="handleVoucherCodeInput"
          bindconfirm="handleSubmit"
        />
      </view>

      <view class="action-row">
        <view class="action-btn secondary" bindtap="scanVoucherCode">扫码识别</view>
        <view class="action-btn primary {{loading ? 'disabled' : ''}}" bindtap="handleSubmit">
          <text wx:if="{{loading}}">核销中</text>
          <text wx:else>确认核销</text>
        </view>
      </view>

      <view wx:if="{{resultVisible}}" class="result-card">
        <view class="result-title">核销成功</view>
        <view class="result-line">门店：{{resultStoreName}}</view>
        <block wx:if="{{isExchangeMode}}">
          <view class="result-line">兑换金额：{{resultAmount}} 元</view>
          <view class="result-line">赠送余额：{{resultBalance}} 元</view>
          <view class="result-line">流水号：{{resultTransactionNo || '--'}}</view>
        </block>
        <block wx:else>
          <view class="result-line">发放单次卡：{{resultTimes}} 张</view>
          <view class="result-line">首张卡号：{{resultCardNo}}</view>
        </block>
      </view>
    </view>
  </view>
</view>
