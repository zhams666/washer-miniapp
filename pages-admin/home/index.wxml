<view class="page">
  <view class="admin-return" style="top: {{adminReturnTop}}px;" bindtap="returnToMiniHome">
    <image class="admin-return__icon" mode="aspectFit" src="/assets/icons/admin-return-home.png"></image>
    <text>返回洗车首页</text>
  </view>

  <Navbar
    showBackIcon="{{false}}"
    title="{{workspace.headline}}"
    titleColor="#F6FBFB"
    backgroundColor="#102A31"
    borderBottom="{{false}}"
    bottomShadow="{{false}}"
  ></Navbar>

  <view class="container">
    <view class="hero-card hero-card--{{workspace.tierCode}}">
      <view class="hero-card__top">
        <view>
          <view class="hero-card__eyebrow">{{workspace.tierName}}</view>
          <view class="hero-card__title">{{workspace.headline}}</view>
          <view class="hero-card__desc">{{workspace.description}}</view>
        </view>
        <view class="hero-actions">
          <view class="refresh-button" bindtap="refresh">刷新</view>
          <view class="settings-button" bindtap="openStoreSettings">门店设置</view>
          <view class="switch-button" bindtap="handleSwitchIdentity">切换</view>
        </view>
      </view>
      <view class="scope-line">
        <text>当前范围</text>
        <text>{{workspace.scopeName || '全部'}}</text>
      </view>
      <picker mode="selector" range="{{storePickerOptions}}" value="{{selectedStoreIndex}}" bindchange="handleStoreChange">
        <view class="store-picker">
          <text>{{storePickerOptions[selectedStoreIndex]}}</text>
          <text class="store-picker__arrow">切换</text>
        </view>
      </picker>
    </view>

    <view class="scope-grid">
      <view wx:for="{{scopeSummaryCards}}" wx:key="key" class="scope-card is-clickable" data-key="{{item.key}}" bindtap="handleScopeTap">
        <view class="scope-card__title">{{item.title}}</view>
        <view class="scope-card__value">{{item.value}}<text>{{item.unit}}</text></view>
        <view class="scope-card__desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="metric-grid">
      <view wx:for="{{metricCards}}" wx:key="key" class="metric-card is-clickable" data-key="{{item.key}}" bindtap="handleMetricTap">
        <view class="metric-card__title">{{item.title}}</view>
        <view class="metric-card__value">{{item.value}}<text>{{item.unit}}</text></view>
        <view class="metric-card__desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="device-card is-clickable" bindtap="handleDeviceTap">
      <view class="section-head">
        <view>
          <view class="section-title">设备状态</view>
          <view class="section-subtitle">当前权限范围内设备</view>
        </view>
        <view class="device-card__badge {{deviceStatus.abnormalCount > 0 ? 'is-warning' : 'is-ok'}}">
          {{deviceStatus.abnormalCount > 0 ? deviceStatus.abnormalCount + ' 台异常' : '正常'}}
        </view>
      </view>
      <view class="device-stats">
        <view><text>{{deviceStatus.totalCount || 0}}</text><label>总数</label></view>
        <view><text>{{deviceStatus.runningCount || 0}}</text><label>运行</label></view>
        <view><text>{{deviceStatus.idleCount || 0}}</text><label>空闲</label></view>
        <view><text>{{deviceStatus.faultCount || 0}}</text><label>故障</label></view>
      </view>
      <view class="alert-list" wx:if="{{alerts.length}}">
        <view wx:for="{{alerts}}" wx:key="deviceId" class="alert-item">
          <view>
            <view class="alert-item__title">{{item.deviceName || item.deviceCode || '未命名设备'}}</view>
            <view class="alert-item__meta">{{item.storeName}} / {{item.status}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{storeRankings.length}}">
      <view class="section-head">
        <view>
          <view class="section-title">门店排行</view>
          <view class="section-subtitle">按今日消费和洗车次数排序</view>
        </view>
      </view>
      <view class="ranking-list">
        <view wx:for="{{storeRankings}}" wx:key="storeId" class="ranking-item is-clickable" data-store-id="{{item.storeId}}" bindtap="handleRankingTap">
          <view class="ranking-item__index">{{item.rank}}</view>
          <view class="ranking-item__main">
            <view class="ranking-item__title">{{item.storeName || '未命名门店'}}</view>
            <view class="ranking-item__meta">{{item.franchiseeName || '直营'}} / {{item.deviceText}}台设备 / 异常{{item.abnormalText}}台</view>
          </view>
          <view class="ranking-item__side">
            <view class="ranking-item__amount">¥{{item.consumeAmountText}}</view>
            <view class="ranking-item__count">{{item.washCountText}}单</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <view>
          <view class="section-title">快捷入口</view>
          <view class="section-subtitle">当前角色高频操作</view>
        </view>
      </view>
      <view class="quick-grid">
        <view wx:for="{{quickActions}}" wx:key="key" class="quick-card" data-key="{{item.key}}" bindtap="handleQuickTap">
          <view class="quick-card__icon">
            <Icon url="{{item.icon}}" size="40rpx"></Icon>
          </view>
          <view class="quick-card__title">{{item.title}}</view>
          <view class="quick-card__desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <view>
          <view class="section-title">最近动态</view>
          <view class="section-subtitle">订单和钱包流水</view>
        </view>
      </view>
      <view class="activity-list">
        <view wx:for="{{recentActivities}}" wx:key="referenceNo" class="activity-item is-clickable" data-type="{{item.type}}" data-reference-no="{{item.referenceNo}}" bindtap="handleActivityTap">
          <view>
            <view class="activity-item__title">{{item.title}}</view>
            <view class="activity-item__meta">{{item.storeName}} / {{item.referenceNo || '--'}}</view>
          </view>
          <view class="activity-item__amount">¥{{item.amountText}}</view>
        </view>
        <view wx:if="{{!recentActivities.length && !loading}}" class="empty-text">暂无动态</view>
      </view>
    </view>
  </view>

  <view wx:if="{{settingsVisible}}" class="settings-mask" bindtap="closeStoreSettings">
    <view class="settings-drawer" catchtap="noop">
      <view class="settings-head">
        <text>修改</text>
        <view class="settings-close" bindtap="closeStoreSettings">×</view>
      </view>
      <scroll-view scroll-y class="settings-body">
        <view wx:if="{{settingsLoading}}" class="settings-loading">加载中...</view>
        <block wx:else>
          <view class="settings-row required">
            <text class="settings-label">场所名称</text>
            <input class="settings-input" value="{{settingsForm.storeName}}" data-field="storeName" bindinput="handleSettingsInput" placeholder="请输入场所名称" />
          </view>
          <view class="settings-row required">
            <text class="settings-label">场所地区</text>
            <input class="settings-input" value="{{settingsForm.province}}" data-field="province" bindinput="handleSettingsInput" placeholder="省/市/区" />
          </view>
          <view class="settings-row required">
            <text class="settings-label">场所地段</text>
            <input class="settings-input" value="{{settingsForm.address}}" data-field="address" bindinput="handleSettingsInput" placeholder="请输入详细地址" />
          </view>
          <view class="settings-row required">
            <text class="settings-label">场所管理员</text>
            <input class="settings-input" value="{{settingsForm.contactName}}" data-field="contactName" bindinput="handleSettingsInput" placeholder="请输入管理员" />
          </view>
          <view class="settings-title">关门洗车区间设置</view>
          <view class="settings-row required">
            <text class="settings-label">区间一</text>
            <input class="settings-number" type="number" value="{{settingsForm.doorCloseIntervalOneStart}}" data-field="doorCloseIntervalOneStart" bindinput="handleSettingsInput" placeholder="0" />
            <text class="settings-gap">-</text>
            <input class="settings-number" type="number" value="{{settingsForm.doorCloseIntervalOneEnd}}" data-field="doorCloseIntervalOneEnd" bindinput="handleSettingsInput" placeholder="0" />
          </view>
          <view class="settings-row required">
            <text class="settings-label">区间二</text>
            <input class="settings-number" type="number" value="{{settingsForm.doorCloseIntervalTwoStart}}" data-field="doorCloseIntervalTwoStart" bindinput="handleSettingsInput" placeholder="0" />
            <text class="settings-gap">-</text>
            <input class="settings-number" type="number" value="{{settingsForm.doorCloseIntervalTwoEnd}}" data-field="doorCloseIntervalTwoEnd" bindinput="handleSettingsInput" placeholder="0" />
          </view>
          <view class="settings-row required">
            <text class="settings-label">注册奖励金</text>
            <input class="settings-input" type="digit" value="{{settingsForm.registerRewardAmount}}" data-field="registerRewardAmount" bindinput="handleSettingsInput" placeholder="0" />
            <text class="settings-unit">元</text>
          </view>
          <view class="settings-row required">
            <text class="settings-label">邀请奖励金</text>
            <input class="settings-input" type="digit" value="{{settingsForm.inviteRewardAmount}}" data-field="inviteRewardAmount" bindinput="handleSettingsInput" placeholder="0" />
            <text class="settings-unit">元</text>
          </view>
          <view class="settings-row settings-row--textarea required">
            <text class="settings-label">活动介绍</text>
            <textarea class="settings-textarea" value="{{settingsForm.activityIntro}}" data-field="activityIntro" bindinput="handleSettingsInput" placeholder="请输入活动介绍"></textarea>
          </view>
          <view class="settings-row settings-row--textarea required">
            <text class="settings-label">充值说明</text>
            <textarea class="settings-textarea" value="{{settingsForm.rechargeDescription}}" data-field="rechargeDescription" bindinput="handleSettingsInput" placeholder="请输入充值说明"></textarea>
          </view>
          <view class="settings-row settings-row--textarea required">
            <text class="settings-label">会员说明</text>
            <textarea class="settings-textarea" value="{{settingsForm.memberDescription}}" data-field="memberDescription" bindinput="handleSettingsInput" placeholder="请输入会员说明"></textarea>
          </view>
          <view class="settings-row required">
            <text class="settings-label">管理员手机号</text>
            <input class="settings-input" type="number" value="{{settingsForm.contactPhone}}" data-field="contactPhone" bindinput="handleSettingsInput" placeholder="请输入手机号" />
          </view>
          <view class="settings-row required">
            <text class="settings-label">开柜最低单充金额</text>
            <input class="settings-input" type="digit" value="{{settingsForm.cabinetMinRechargeAmount}}" data-field="cabinetMinRechargeAmount" bindinput="handleSettingsInput" placeholder="0" />
          </view>
          <view class="settings-row required">
            <text class="settings-label">开柜最低剩余余额</text>
            <input class="settings-input" type="digit" value="{{settingsForm.cabinetMinBalanceAmount}}" data-field="cabinetMinBalanceAmount" bindinput="handleSettingsInput" placeholder="0" />
          </view>
          <view class="settings-row settings-row--image required">
            <text class="settings-label">场所图片</text>
            <image wx:if="{{settingsForm.coverImage}}" class="settings-image" mode="aspectFill" src="{{settingsForm.coverImage}}"></image>
            <button class="image-button" loading="{{uploadingStoreImage}}" bindtap="chooseStoreImage">
              <text>上传图片</text>
              <text class="image-button__plus">+</text>
            </button>
          </view>
        </block>
      </scroll-view>
      <view class="settings-footer">
        <button class="settings-save" loading="{{settingsSaving}}" bindtap="handleSaveStoreSettings">确认保存</button>
      </view>
    </view>
  </view>
</view>
