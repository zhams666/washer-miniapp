<view class="page">
  <Navbar title="设备管理" customBackPath="/pages-admin/home/index" customBackPathIsTabbar="{{false}}"></Navbar>

  <view class="container">
    <view class="filter-card">
      <picker mode="selector" range="{{storePickerOptions}}" value="{{selectedStoreIndex}}" bindchange="handleStoreChange">
        <view class="picker-row">
          <text>{{storePickerOptions[selectedStoreIndex]}}</text>
          <label>切换门店</label>
        </view>
      </picker>
      <view class="search-row">
        <input value="{{keyword}}" placeholder="设备名称或编码" bindinput="handleKeywordInput" confirm-type="search" bindconfirm="handleSearch" />
        <view class="search-button" bindtap="handleSearch">搜索</view>
      </view>
    </view>

    <view class="device-list">
      <view wx:for="{{devices}}" wx:key="id" class="device-card">
        <view class="device-card__top">
          <view>
            <view class="device-card__title">{{item.deviceName || item.deviceCode || '未命名设备'}}</view>
            <view class="device-card__meta">{{item.storeName || '未知门店'}} · {{item.deviceCode || '--'}}</view>
          </view>
          <view class="status-pill status-{{item.statusClass}}">{{item.displayStatus}}</view>
        </view>
        <view class="device-card__info">
          <text>{{item.deviceType || 'washer'}}</text>
          <text>{{item.protocolType || '协议待补充'}}</text>
          <text>{{item.firmwareVersion || '版本未知'}}</text>
        </view>
        <view class="device-card__actions">
          <button
            class="action-button action-button--primary"
            wx:if="{{item.statusClass !== 'running'}}"
            loading="{{operatingId === item.id}}"
            data-id="{{item.id}}"
            bindtap="handleStart"
          >启动</button>
          <button
            class="action-button action-button--warning"
            wx:if="{{item.statusClass === 'running'}}"
            loading="{{operatingId === item.id}}"
            data-id="{{item.id}}"
            bindtap="handleStop"
          >停止</button>
        </view>
      </view>
      <view wx:if="{{!devices.length && !loading}}" class="empty-text">暂无设备</view>
    </view>
  </view>
</view>
